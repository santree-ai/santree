# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Production source maps, moved out of dist/ by scripts/stash-sourcemaps.mjs so
# they never reach the app bundle. Keep the matching sourcemaps/<version>/ folder
# with each release artifact — `pnpm symbolicate` needs it to read a user's stack
# trace — but it holds the full frontend source, so it doesn't belong in git.
sourcemaps

# TanStack Router plugin cache
.tanstack

# Claude Code: session/worktree state stays local, but shared project config
# (settings, hooks, skills, agents, commands) is versioned so every clone and
# every santree-managed worktree inherits it.
.claude/*
!.claude/settings.json
!.claude/hooks
!.claude/skills
!.claude/agents
!.claude/commands

# Rust / Cargo (workspace target)
/target

# Editor directories and files. Keep the shared workspace recommendations and
# settings (the Tailwind/Biome fix) tracked; ignore everyone's personal files.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# NOTE: src/bindings.ts and src/routeTree.gen.ts are GENERATED but committed,
# so they are intentionally NOT ignored — release builds rely on them.
