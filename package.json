{
  "name": "santree-app",
  "private": true,
  "version": "0.1.2-beta.6",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:hook": "set -e; base=${CARGO_TARGET_DIR:-target}; host=$(rustc -vV | awk '/^host:/{print $2}'); triple=${TAURI_ENV_TARGET_TRIPLE:-$host}; if [ x${TAURI_ENV_DEBUG:-} = xtrue ]; then profile=debug; flags=; else profile=release; flags=--release; fi; out=target/bundle-resources; mkdir -p $out; case $triple in universal-apple-darwin) cargo build -p santree-hook $flags --target aarch64-apple-darwin --target x86_64-apple-darwin; lipo -create -output $out/santree-hook $base/aarch64-apple-darwin/$profile/santree-hook $base/x86_64-apple-darwin/$profile/santree-hook;; $host) cargo build -p santree-hook $flags; cp $base/$profile/santree-hook $out/santree-hook;; *) cargo build -p santree-hook $flags --target $triple; cp $base/$triple/$profile/santree-hook $out/santree-hook;; esac",
    "gen:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings_succeeds",
    "stash:sourcemaps": "node scripts/stash-sourcemaps.mjs",
    "eject:stale-dmg": "node scripts/eject-stale-dmg.mjs",
    "symbolicate": "node scripts/symbolicate.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:dev": "cd website && pnpm dev",
    "site:build": "cd website && pnpm build",
    "site:typecheck": "cd website && pnpm typecheck",
    "sign:resources": "node scripts/sign-resources.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@git-diff-view/react": "^0.1.6",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "material-icon-theme": "^5.36.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "refractor": "^5.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
