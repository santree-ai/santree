{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "santree",
  "version": "0.1.2-beta.1",
  "identifier": "com.santree.desktop",
  "build": {
    "beforeDevCommand": "pnpm bundle:hook && pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bundle:hook && pnpm build && pnpm stash:sourcemaps",
    "beforeBundleCommand": "pnpm eject:stale-dmg && pnpm sign:resources",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "santree",
        "width": 1320,
        "height": 830,
        "minWidth": 1040,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../target/bundle-resources/santree-hook": "santree-hook"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNzg4MjFEMDk3NzZGOTYKUldTV2IzY0pIWUo0a0MzQWQxQ2Z5VlZLQWxMOUI4cnNBVkxic1orajUwdVVraDh6WjJpN3lmREkK",
      "endpoints": ["https://github.com/santree-ai/santree/releases/latest/download/latest.json"]
    }
  }
}
